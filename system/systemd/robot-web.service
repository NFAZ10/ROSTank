[Unit]
Description=Tracked robot web UI (http://<robot-ip>:8080): map, drive, calibration, stack start/stop
After=network-online.target robot.service
Wants=network-online.target

[Service]
User=nfazio
Group=nfazio
SupplementaryGroups=dialout
WorkingDirectory=/home/nfazio
ExecStart=/home/nfazio/robot_ws/start_web.sh
KillSignal=SIGINT
TimeoutStopSec=10
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
