[Unit]
Description=Tracked robot battery monitor and low-battery shutdown (runs with or without the stack)
After=network-online.target
Wants=network-online.target

[Service]
User=nfazio
Group=nfazio
SupplementaryGroups=dialout
WorkingDirectory=/home/nfazio
ExecStart=/home/nfazio/robot_ws/start_battery.sh
KillSignal=SIGINT
TimeoutStopSec=10
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
