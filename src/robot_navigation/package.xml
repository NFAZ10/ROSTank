<?xml version="1.0"?>
<package format="3">
  <name>robot_navigation</name>
  <version>0.1.0</version>
  <description>slam_toolbox mapping and Nav2 navigation for the tracked robot.</description>
  <maintainer email="nick.fazio@gmail.com">nfazio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
